{
  "name": "customer_orders",
  "version": "1.2.0",
  "owner": "billing-analytics",
  "description": "Daily order extract used for finance and customer reporting.",
  "freshness_hours": 24,
  "fields": [
    {"name": "order_id", "type": "string", "required": true, "unique": true},
    {"name": "customer_id", "type": "string", "required": true},
    {"name": "order_date", "type": "date", "required": true},
    {"name": "amount_eur", "type": "number", "required": true, "min": 0},
    {"name": "status", "type": "string", "required": true, "allowed": ["paid", "refunded", "pending"]}
  ],
  "downstream": [
    {"asset": "mart_daily_revenue", "tier": "critical", "reason": "Finance daily close"},
    {"asset": "mart_customer_ltv", "tier": "high", "reason": "Retention reporting"},
    {"asset": "sales_ops_dashboard", "tier": "medium", "reason": "Operational monitoring"}
  ]
}
